function Library.CreateInput(config)
	config = config or {}
	local label = config.label or "Input"
	local placeholder = config.placeholder or "Enter text..."
	local position = config.position or UDim2.new(0.5, 0, 0.1, 0)
	local callback = config.callback

	local gui = createScreenGui("InputGui")

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0.9, 0, 0, 80)
	frame.AutomaticSize = Enum.AutomaticSize.Y -- grows when the text needs more lines
	frame.Position = position
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
	frame.BorderSizePixel = 0
	frame.Parent = gui
	limitWidth(frame, 440)
	corner(frame, UDim.new(0, 12))
	stroke(frame, 2)

	local framePad = Instance.new("UIPadding")
	framePad.PaddingBottom = UDim.new(0, 6)
	framePad.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -20, 0, 25)
	title.Position = UDim2.new(0, 10, 0, 5)
	title.BackgroundTransparency = 1
	title.Text = label
	title.Font = Enum.Font.GothamBold
	title.TextSize = 18
	title.TextColor3 = Color3.new(0, 0, 0)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame

	local boxFrame = Instance.new("Frame")
	boxFrame.Size = UDim2.new(1, -20, 0, 40)
	boxFrame.AutomaticSize = Enum.AutomaticSize.Y
	boxFrame.Position = UDim2.new(0, 10, 0, 35)
	boxFrame.BackgroundColor3 = Color3.new(1, 1, 1)
	boxFrame.BorderSizePixel = 0
	boxFrame.Parent = frame
	corner(boxFrame, UDim.new(0, 8))
	local boxStroke = stroke(boxFrame, 1.5)

	local boxPad = Instance.new("UIPadding")
	boxPad.PaddingTop = UDim.new(0, 4)
	boxPad.PaddingBottom = UDim.new(0, 4)
	boxPad.PaddingLeft = UDim.new(0, 8)
	boxPad.PaddingRight = UDim.new(0, 8)
	boxPad.Parent = boxFrame

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, 0, 0, 32)
	box.AutomaticSize = Enum.AutomaticSize.Y   -- long text = new lines, the box grows
	box.BackgroundTransparency = 1
	box.Text = tostring(config.default or "")
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
	box.TextColor3 = Color3.new(0, 0, 0)
	box.TextSize = 16
	box.Font = Enum.Font.Gotham
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.TextYAlignment = Enum.TextYAlignment.Center
	box.ClearTextOnFocus = false
	box.MultiLine = true
	box.TextWrapped = true
	box.Parent = boxFrame

	-- Enter / Return submits instead of adding an empty line
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if string.find(box.Text, "[\r\n]") then
			box.Text = (string.gsub(box.Text, "[\r\n]", ""))
			box:ReleaseFocus(true)
		end
	end)

	box.Focused:Connect(function()
		TweenService:Create(boxStroke, TweenInfo.new(0.2), {
			Color = Color3.fromRGB(100, 150, 255),
			Thickness = 2
		}):Play()
	end)

	box.FocusLost:Connect(function(enterPressed)
		TweenService:Create(boxStroke, TweenInfo.new(0.2), {
			Color = Color3.new(0, 0, 0),
			Thickness = 1.5
		}):Play()
		-- onChange: always (keeps the original element's text in sync)
		safe(config.onChange, box.Text)
		-- callback: only when Enter is pressed
		if enterPressed then
			safe(callback, box.Text)
		end
	end)

	return {
		frame = frame,
		textBox = box,
		setText = function(t)
			t = tostring(t or "")
			if box.Text ~= t then box.Text = t end
		end,
		getText = function() return box.Text end,
		destroy = function() gui:Destroy() end
	}
end

function Library.CreateDropdown(config)
	config = config or {}
	local label = config.label or "Dropdown"
	local options = config.options or {}
	local multi = config.multi and true or false
	local position = config.position or UDim2.new(0.5, 0, 0.1, 0)
	local callback = config.callback

	-- state: multi = list of picked names, single = one picked name
	local selectedParts = {}
	local selectedOption = nil
	if multi then
		if type(config.default) == "table" then
			for _, n in ipairs(config.default) do
				if table.find(options, n) and not table.find(selectedParts, n) then
					table.insert(selectedParts, n)
				end
			end
		end
	else
		selectedOption = config.default or options[1]
	end

	local collapsedHeight = 90
	local optionHeight = 35

	-- only DROPDOWN_MAX_VISIBLE options are visible at once, the rest scrolls
	local scrollable = #options > DROPDOWN_MAX_VISIBLE
	local listHeight = math.min(#options, DROPDOWN_MAX_VISIBLE) * optionHeight

	local gui = createScreenGui("DropdownGui")

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0.9, 0, 0, collapsedHeight)
	frame.Position = position
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
	frame.BorderSizePixel = 0
	frame.Parent = gui
	limitWidth(frame, 440)
	corner(frame, UDim.new(0, 12))
	stroke(frame, 2)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -20, 0, 25)
	title.Position = UDim2.new(0, 10, 0, 5)
	title.BackgroundTransparency = 1
	title.Text = label
	title.Font = Enum.Font.GothamBold
	title.TextSize = 20
	title.TextColor3 = Color3.new(0, 0, 0)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Parent = frame

	local box = Instance.new("Frame")
	box.Size = UDim2.new(1, -20, 0, 45)
	box.Position = UDim2.new(0.5, 0, 0, 35)
	box.AnchorPoint = Vector2.new(0.5, 0)
	box.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
	box.BackgroundTransparency = 0.2
	box.BorderSizePixel = 0
	box.Parent = frame
	corner(box, UDim.new(0, 4))
	stroke(box, 1)

	local sel = Instance.new("TextButton")
	sel.Size = UDim2.new(1, -20, 1, -10)
	sel.Position = UDim2.new(0, 10, 0.5, 0)
	sel.AnchorPoint = Vector2.new(0, 0.5)
	sel.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
	sel.BorderSizePixel = 0
	sel.Text = ""
	sel.Font = Enum.Font.Gotham
	sel.TextSize = 14
	sel.TextColor3 = Color3.new(0, 0, 0)
	sel.TextXAlignment = Enum.TextXAlignment.Left
	sel.TextTruncate = Enum.TextTruncate.AtEnd
	sel.AutoButtonColor = false
	sel.ZIndex = 2
	sel.Parent = box
	corner(sel, UDim.new(0, 4))
	stroke(sel, 1)

	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = sel

	local list = Instance.new("Frame")
	list.Size = UDim2.new(1, -20, 0, 0)
	list.Position = UDim2.new(0, 10, 1, 5)
	list.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
	list.BackgroundTransparency = 0.2
	list.BorderSizePixel = 0
	list.Visible = false
	list.ClipsDescendants = true
	list.ZIndex = 3
	list.Parent = box
	corner(list, UDim.new(0, 4))
	stroke(list, 1)

	-- the options live in a scrolling frame inside the list
	local optionScroll = Instance.new("ScrollingFrame")
	optionScroll.Name = "OptionScroll"
	optionScroll.Size = UDim2.new(1, 0, 1, 0)
	optionScroll.BackgroundTransparency = 1
	optionScroll.BorderSizePixel = 0
	optionScroll.ScrollBarThickness = scrollable and 4 or 0
	optionScroll.ScrollBarImageColor3 = Color3.new(0, 0, 0)
	optionScroll.CanvasSize = UDim2.new(0, 0, 0, #options * optionHeight)
	optionScroll.ScrollingDirection = Enum.ScrollingDirection.Y
	optionScroll.ZIndex = 4
	optionScroll.Parent = list

	local isOpen = false
	local rows = {}

	-- redraws every option + the selection text from the current state
	local function refresh(animate)
		for name, r in pairs(rows) do
			if multi then
				local on = table.find(selectedParts, name) ~= nil
				r.dot.Size = UDim2.new(0, 8, 0, 8)
				r.dot.BackgroundColor3 = on and Color3.fromRGB(128, 128, 128) or Color3.new(0, 0, 0)
				r.button.BackgroundColor3 = on and Color3.fromRGB(210, 210, 210) or Color3.fromRGB(245, 245, 245)
			else
				local size = (name == selectedOption) and UDim2.new(0, 8, 0, 8) or UDim2.new(0, 4, 0, 4)
				if animate then
					TweenService:Create(r.dot, TweenInfo.new(0.25), {Size = size}):Play()
				else
					r.dot.Size = size
				end
			end
		end
		if multi then
			sel.Text = table.concat(selectedParts, ", ")
		else
			sel.Text = selectedOption or ""
		end
	end

	-- v = list (multi) or name (single). silent = don't fire the callback
	local function setSelected(v, silent)
		if multi then
			selectedParts = {}
			if type(v) == "table" then
				for _, n in ipairs(v) do
					if table.find(options, n) and not table.find(selectedParts, n) then
						table.insert(selectedParts, n)
					end
				end
			end
		elseif v ~= nil and table.find(options, v) then
			selectedOption = v
		end
		refresh(true)
		if not silent then
			if multi then
				safe(callback, table.clone(selectedParts))
			else
				safe(callback, selectedOption)
			end
		end
	end

	local function setOpen(state)
		isOpen = state
		if state then
			list.Visible = true
			list.Size = UDim2.new(1, -20, 0, 0)
			TweenService:Create(list, TweenInfo.new(0.2), {Size = UDim2.new(1, -20, 0, listHeight)}):Play()
			TweenService:Create(frame, TweenInfo.new(0.2), {Size = UDim2.new(0.9, 0, 0, collapsedHeight + listHeight + 10)}):Play()
		else
			local t = TweenService:Create(list, TweenInfo.new(0.2), {Size = UDim2.new(1, -20, 0, 0)})
			t:Play()
			TweenService:Create(frame, TweenInfo.new(0.2), {Size = UDim2.new(0.9, 0, 0, collapsedHeight)}):Play()
			t.Completed:Connect(function()
				if not isOpen then list.Visible = false end
			end)
		end
	end

	for i, name in ipairs(options) do
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, scrollable and -6 or 0, 0, optionHeight)
		b.Position = UDim2.new(0, 0, 0, (i - 1) * optionHeight)
