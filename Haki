		-- finds the HTTP function of the executor
		local function getRequestFunction()
			if type(request) == "function" then return request end
			if type(http_request) == "function" then return http_request end
			if syn and type(syn.request) == "function" then return syn.request end
			if http and type(http.request) == "function" then return http.request end
			if fluxus and type(fluxus.request) == "function" then return fluxus.request end
			return nil
		end

		-- sends the rating to the Discord webhook, returns true when it worked
		local function sendToDiscord(stars)
			local req = getRequestFunction()
			if not req then return false end

			local starText = string.rep("★", stars) .. string.rep("☆", 5 - stars)
			local okEncode, body = pcall(function()
				return HttpService:JSONEncode({
					username = "Feedback",
					embeds = {{
						title = "New Feedback",
						color = 16777215,
						fields = {
							{name = "Stars", value = stars .. " / 5   " .. starText, inline = false},
							{name = "Player", value = player.DisplayName .. " (@" .. player.Name .. ")", inline = true},
							{name = "User ID", value = tostring(player.UserId), inline = true},
							{name = "Place ID", value = tostring(game.PlaceId), inline = true},
						},
						footer = {text = tostring(title)},
					}},
				})
			end)
			if not okEncode then return false end

			local ok, res = pcall(req, {
				Url = FEEDBACK_WEBHOOK_URL,
				Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = body,
			})
			if not ok or type(res) ~= "table" then return false end
			if res.Success then return true end
			local code = tonumber(res.StatusCode)
			return code ~= nil and code >= 200 and code < 300
		end

		local sendLabel
		local function onSend()
			if sending then return end

			if selected == 0 then
				setStatus("Please choose a star rating first.", true)
				Library:CreateNotification("Please choose a star rating first.", 3)
				return
			end

			local remaining = FEEDBACK_COOLDOWN - (os.clock() - lastSent)
			if lastSent > 0 and remaining > 0 then
				setStatus("Please wait " .. math.ceil(remaining) .. " seconds before you send more feedback.", true)
				return
			end

			sending = true
			if sendLabel then sendLabel.Text = "Sending..." end
			local stars = selected

			task.spawn(function()
				local ok = sendToDiscord(stars)
				sending = false
				if sendLabel then sendLabel.Text = "Send Feedback" end

				if ok then
					lastSent = os.clock()
					setStatus("Thank you for your feedback! You gave us " .. stars .. (stars == 1 and " star." or " stars."), false)
					Library:CreateNotification("Thank you for your feedback! We really appreciate your help.", 5)
					selected = 0
					refreshStars()
				else
					setStatus("Sorry, your feedback could not be sent. Please try again later.", true)
					Library:CreateNotification("Sorry, your feedback could not be sent. Please try again later.", 4)
				end
			end)
