		local moved = {}    -- the real rows currently shown here
		local wrappers = {} -- the tree wrappers (line + indent) around the moved rows
		local headers = {}  -- the tab-name labels currently shown here

		-- tab-name label that goes on top of every group of results: —( Main )
		local function makeHeader(text, order)
			text = "—( " .. tostring(text) .. " )"
			local textW = TextService:GetTextSize(text, 13, Enum.Font.GothamBold, Vector2.new(1000, 24)).X

