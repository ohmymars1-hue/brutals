		b.Text = ""
		b.AutoButtonColor = false
		b.ZIndex = 4
		b:SetAttribute("NoDrag", true) -- scrolling the list must not move the copy
		b.Parent = optionScroll

		if i < #options then
			local sep = Instance.new("Frame")
			sep.Size = UDim2.new(1, 0, 0, 1)
			sep.Position = UDim2.new(0, 0, 1, 0)
			sep.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
			sep.BorderSizePixel = 0
			sep.ZIndex = 5
			sep.Parent = b
		end

		local dot = Instance.new("Frame")
		dot.Size = UDim2.new(0, 4, 0, 4)
		dot.Position = UDim2.new(0, 12, 0.5, 0)
		dot.AnchorPoint = Vector2.new(0, 0.5)
		dot.BackgroundColor3 = Color3.new(0, 0, 0)
		dot.BorderSizePixel = 0
		dot.ZIndex = 5
		dot.Parent = b
		corner(dot, UDim.new(1, 0))

		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.new(1, -30, 1, 0)
		txt.Position = UDim2.new(0, 30, 0, 0)
		txt.BackgroundTransparency = 1
		txt.Text = name
		txt.Font = Enum.Font.Gotham
		txt.TextSize = 16
		txt.TextColor3 = Color3.new(0, 0, 0)
		txt.TextXAlignment = Enum.TextXAlignment.Left
		txt.ZIndex = 5
		txt.Parent = b

		rows[name] = {button = b, dot = dot}

		b.Activated:Connect(function()
			if multi then
				local nextSel = table.clone(selectedParts)
				local idx = table.find(nextSel, name)
				if idx then
					table.remove(nextSel, idx)
				else
					table.insert(nextSel, name)
				end
				setSelected(nextSel)
			else
				setSelected(name)
			end
		end)
	end

	refresh(false)

	-- only the box itself opens/closes the list
	sel.Activated:Connect(function()
		if DragState.guard() then return end
		setOpen(not isOpen)
	end)

	return {
		frame = frame,
		setSelected = setSelected,
		getSelected = function()
			return multi and table.clone(selectedParts) or selectedOption
		end,
		destroy = function() gui:Destroy() end
	}
end

