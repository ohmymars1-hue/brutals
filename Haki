		lens.Position = UDim2.new(0, 13, 0, 7)
		lens.BackgroundTransparency = 1
		lens.BorderSizePixel = 0
		lens.ZIndex = 100
		lens.Parent = bar
		corner(lens, UDim.new(1, 0))
		local lensStroke = stroke(lens, 2)
		lensStroke.ZIndex = 100

		local handle = Instance.new("Frame")
