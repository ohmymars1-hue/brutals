----------------------------------------------------------------------
-- STANDALONE SETTINGS (draggable / size / wide) and decoration of copies
----------------------------------------------------------------------
local standaloneSettings = {draggable = true, size = 50, wide = 50}

-- size slider: 50 = original, below = smaller (down to 0.5x), above = bigger (up to 2x)
local function sizeToScale(v)
	v = math.clamp(v, 0, 100)
	if v <= 50 then
		return 0.5 + (v / 50) * 0.5
	end
	return 1 + ((v - 50) / 50)
end

-- wide slider: 50 = original width, below = thinner (down to 0.55x), above = wider (up to 1.6x)
local function wideFactor(v)
	v = math.clamp(v, 0, 100)
	if v <= 50 then
		return 0.55 + (v / 50) * 0.45
	end
	return 1 + ((v - 50) / 50) * 0.6
end

local function applyStandaloneSettings()
	for _, item in ipairs(standaloneItems) do
		if item.applySettings then
			pcall(item.applySettings, true)
		end
	end
end

function Library.SetStandaloneDraggable(state)
	standaloneSettings.draggable = state and true or false
	applyStandaloneSettings()
end

function Library.SetStandaloneSize(v)
	standaloneSettings.size = math.clamp(tonumber(v) or 50, 0, 100)
	applyStandaloneSettings()
end

function Library.SetStandaloneWide(v)
	standaloneSettings.wide = math.clamp(tonumber(v) or 50, 0, 100)
	applyStandaloneSettings()
end

-- smallest width each kind of standalone can get so its text/controls still fit
local function standaloneKind(frame)
	local n = frame.Parent and frame.Parent.Name or ""
	if string.find(n, "^SliderGui") then return 250 end
	if string.find(n, "^ToggleGui") then return 190 end
	if string.find(n, "^DropdownGui") then return 190 end
	if string.find(n, "^InputGui") then return 190 end
	if string.find(n, "^ButtonGui") then return 100 end
	return 150 -- info / warning text (it wraps and grows taller instead)
end

-- put a new copy below the others so nothing covers a drag handle
local function placeStandalone(frame)
	local vp = workspace.CurrentCamera.ViewportSize
	local y = 64
	for _, other in ipairs(standaloneItems) do
		local f = other.frame
		if f and f.Parent then
			y = math.max(y, f.AbsolutePosition.Y + f.AbsoluteSize.Y + 36)
		end
	end
	if y > vp.Y - 100 then
		y = 64 + (#standaloneItems % 6) * 18
	end
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.Position = UDim2.fromOffset(vp.X / 2, y)
end

local standaloneOrder = 10
local DRAG_START = 8 -- pixels you have to move before a press turns into a drag

-- finger tracking: a thumbstick / jump button finger must never cancel a hold or a drag
local function sameTouch(refInput, lastPos, input)
	if input == refInput then return true end
	if input.UserInputType ~= refInput.UserInputType then return false end
	if refInput.UserInputType == Enum.UserInputType.Touch then
		return (Vector2.new(input.Position.X, input.Position.Y) - lastPos).Magnitude < 45
	end
	return true
end

local function isMoveOf(refInput, lastPos, input)
	if refInput.UserInputType == Enum.UserInputType.Touch then
		return input.UserInputType == Enum.UserInputType.Touch and sameTouch(refInput, lastPos, input)
	end
	return input.UserInputType == Enum.UserInputType.MouseMovement
end

-- makes every text fit inside its box (shrinks / wraps) instead of showing "..."
local function fitText(d)
	if (d:IsA("TextLabel") or d:IsA("TextButton"))
		and d.AutomaticSize == Enum.AutomaticSize.None then
		local sz = d.TextSize
		d.TextTruncate = Enum.TextTruncate.None
		d.TextWrapped = true
		d.TextScaled = true
		local c = d:FindFirstChildOfClass("UITextSizeConstraint")
		if not c then
			c = Instance.new("UITextSizeConstraint")
			c.Parent = d
		end
		c.MinTextSize = 8
		c.MaxTextSize = math.max(sz, 8)
	end
end

local function registerStandalone(item)
	local frame = item.frame
	if frame and frame.Parent then
		local gui = frame.Parent
		local minW = standaloneKind(frame)

		placeStandalone(frame)

		-- width control: a size constraint we fully own (works for every kind)
		local constraint = frame:FindFirstChildOfClass("UISizeConstraint")
		if not constraint then
			constraint = Instance.new("UISizeConstraint")
			constraint.Parent = frame
		end
		local vp0 = workspace.CurrentCamera.ViewportSize
		local origW = math.min(frame.Size.X.Scale * vp0.X + frame.Size.X.Offset, constraint.MaxSize.X)
		origW = math.max(origW, minW)
		constraint.MinSize = Vector2.new(origW, 0)
		constraint.MaxSize = Vector2.new(origW, 4096)

		local scale = Instance.new("UIScale")
		scale.Parent = frame

		-- texts always stay readable, even when the copy is very small / thin
		fitText(frame)
		for _, d in ipairs(frame:GetDescendants()) do
			fitText(d)
		end

		local function bringToFront()
			standaloneOrder += 1
			gui.DisplayOrder = standaloneOrder
		end

		-- GRAB ZONE: slightly bigger than the copy and behind its controls, so
		-- empty areas and the edges are easy to grab with a thumb.
		local zone = Instance.new("TextButton")
		zone.Name = "GrabZone"
		zone.Size = UDim2.new(1, 24, 1, 24)
		zone.Position = UDim2.new(0.5, 0, 0.5, 0)
		zone.AnchorPoint = Vector2.new(0.5, 0.5)
		zone.BackgroundTransparency = 1
		zone.Text = ""
		zone.AutoButtonColor = false
		zone.ZIndex = 0
		zone.Parent = frame

		local candidate, dragging = false, false
		local pressInput, lastPos, pressPos, dragStart, startPos
		local pressTime = 0

		local function onPress(input)
			if not isPress(input) then return end
			bringToFront()
			if not standaloneSettings.draggable then return end
			if candidate then
				if os.clock() - pressTime < 6 then return end
				candidate = false -- a release was missed, start fresh
			end
			candidate = true
			dragging = false
			pressInput = input
			pressTime = os.clock()
			pressPos = Vector2.new(input.Position.X, input.Position.Y)
			lastPos = pressPos
		end

		-- press anywhere on the copy (background, text, buttons...) can start a
		-- drag; real taps still work because a drag only starts after moving.
		zone.InputBegan:Connect(onPress)
		frame.InputBegan:Connect(onPress)
		for _, d in ipairs(frame:GetDescendants()) do
			if d:IsA("GuiButton") and d ~= zone and not d:GetAttribute("NoDrag") then
				d.InputBegan:Connect(onPress)
			end
		end

		-- SMALL RED X (top right): deletes this floating copy.
		-- It sits half outside the top-right corner; frames that have a UIPadding
		-- (info / warning text) are compensated so it lands in the same spot.
		local framePad = frame:FindFirstChildOfClass("UIPadding")
		local padR = framePad and framePad.PaddingRight.Offset or 0
		local padT = framePad and framePad.PaddingTop.Offset or 0

		local closeBtn = Instance.new("TextButton")
		closeBtn.Name = "StandaloneClose"
		closeBtn.Size = UDim2.new(0, 20, 0, 20)
		closeBtn.AnchorPoint = Vector2.new(0.5, 0.5)
		closeBtn.Position = UDim2.new(1, -2 + padR, 0, 2 - padT)
		closeBtn.BackgroundColor3 = Color3.fromRGB(225, 55, 55)
		closeBtn.BorderSizePixel = 0
		closeBtn.Text = ""
		closeBtn.AutoButtonColor = false
		closeBtn.ZIndex = 50
		closeBtn:SetAttribute("NoDrag", true)
		closeBtn.Parent = frame
		corner(closeBtn, UDim.new(1, 0))
		stroke(closeBtn, 1.5)

		for _, rot in ipairs({45, -45}) do
			local bar = Instance.new("Frame")
			bar.AnchorPoint = Vector2.new(0.5, 0.5)
			bar.Position = UDim2.new(0.5, 0, 0.5, 0)
			bar.Size = UDim2.new(0, 10, 0, 2.5)
			bar.BackgroundColor3 = Color3.new(1, 1, 1)
			bar.BorderSizePixel = 0
			bar.Rotation = rot
			bar.ZIndex = 51
			bar.Parent = closeBtn
			corner(bar, UDim.new(1, 0))
		end

		closeBtn.Activated:Connect(function()
			if DragState.guard() then return end
			local idx = table.find(standaloneItems, item)
			if idx then table.remove(standaloneItems, idx) end
			pcall(function() item.destroy() end)
		end)

		local moveConn, endConn

		moveConn = UserInputService.InputChanged:Connect(function(input)
			if not frame:IsDescendantOf(game) then
				moveConn:Disconnect()
				endConn:Disconnect()
				return
			end
			if not candidate or not isMoveOf(pressInput, lastPos, input) then return end

			local cur = Vector2.new(input.Position.X, input.Position.Y)
			lastPos = cur
			if not dragging then
				if (cur - pressPos).Magnitude < DRAG_START then return end
				dragging = true
				dragStart = cur		   -- start from here so it never jumps
				startPos = frame.Position
			end

			local d = cur - dragStart
			local vp = workspace.CurrentCamera.ViewportSize
			frame.Position = UDim2.new(
				startPos.X.Scale, math.clamp(startPos.X.Offset + d.X, 20, vp.X - 20),
				startPos.Y.Scale, math.clamp(startPos.Y.Offset + d.Y, 30, vp.Y - 30))
		end)

		endConn = UserInputService.InputEnded:Connect(function(input)
			if candidate and isPress(input) and sameTouch(pressInput, lastPos, input) then
				if dragging then
					DragState.lastEnd = os.clock() -- so the drag doesn't also count as a tap
				end
				candidate = false
				dragging = false
			end
		end)

		function item.applySettings(animate)
			zone.Visible = standaloneSettings.draggable
			if not standaloneSettings.draggable then
				candidate = false
				dragging = false
			end

			local sc = sizeToScale(standaloneSettings.size)
			local vp = workspace.CurrentCamera.ViewportSize
			local w = origW * wideFactor(standaloneSettings.wide)
			w = math.min(w, (vp.X - 24) / sc) -- never wider than the screen
			w = math.max(w, minW)			 -- never thinner than its text needs

			local minSize = Vector2.new(w, 0)
			local maxSize = Vector2.new(w, 4096)
			if animate then
				TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Scale = sc}):Play()
				TweenService:Create(constraint, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {MinSize = minSize, MaxSize = maxSize}):Play()
			else
				scale.Scale = sc
				constraint.MinSize = minSize
				constraint.MaxSize = maxSize
			end
		end
		item.applySettings(false)
	end
	table.insert(standaloneItems, item)
end

local function raise(obj, z)
	if obj:IsA("GuiObject") then obj.ZIndex = z end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("GuiObject") then d.ZIndex = z end
	end
end

----------------------------------------------------------------------
-- HOLD SYSTEM
-- Hold any element for HOLD_TIME: the element slightly shrinks and a solid
-- grey cover slides top -> bottom over the WHOLE element. When it finishes
-- the element springs back to its normal size, the grey STAYS, and a
-- STANDALONE button + a red x appear inside it. The red x puts it all back.
-- The element keeps its original design (background, outline, controls).
----------------------------------------------------------------------
local currentHold -- { hold = ..., input = ..., lastPos = Vector2 }
local holdInputHooked = false

local function hookHoldInput()
	if holdInputHooked then return end
	holdInputHooked = true

	UserInputService.InputEnded:Connect(function(input)
		local h = currentHold
		if h and isPress(input) and sameTouch(h.input, h.lastPos, input) then
			currentHold = nil
			h.hold.release()
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		local h = currentHold
		if h and isMoveOf(h.input, h.lastPos, input) then
			local pos = Vector2.new(input.Position.X, input.Position.Y)
			h.lastPos = pos
			h.hold.moved(pos)
		end
	end)
end

-- host: the element's root frame/button
-- spec: { name = "...", spawn = function(position) return item end }
local function makeHold(Window, host, _unused, spec)
	hookHoldInput()

	local hold = {}
	local pressed, fired, cancelled, active = false, false, false, false
	local pressedAt = 0
	local startPos = Vector2.zero
	local token = 0

	local progress, progConn, progTween, shrinkTween
	local clip, fill
	local blocker, saBtn, xBtn
	local bound = {}

	-- Every element sits in a transparent "slot" that always has the element's
	-- real size; the element shrinks around its top-center inside it. The grey
	-- cover, the STANDALONE button and the red x live in an overlay next to the
	-- element (NOT inside it), so they can never make an auto-sized element grow.
	local shrink = Instance.new("UIScale")
	shrink.Name = "HoldShrink"
	shrink.Scale = 1
	shrink.Parent = host

	local slot = Instance.new("Frame")
	slot.Name = "HoldSlot"
	slot.BackgroundTransparency = 1
	slot.BorderSizePixel = 0
	slot.LayoutOrder = host.LayoutOrder
	slot.ZIndex = host.ZIndex
	slot.Position = host.Position
	slot.Size = UDim2.new(1, 0, 0, host.Size.Y.Offset)
	slot.Parent = host.Parent

	local ov = Instance.new("Frame")
	ov.Name = "HoldOverlay"
	ov.BackgroundTransparency = 1
	ov.BorderSizePixel = 0
	ov.AnchorPoint = Vector2.new(0.5, 0)
	ov.Position = UDim2.new(0.5, 0, 0, 0)
	ov.Size = UDim2.new(host.Size.X.Scale, host.Size.X.Offset, 1, 0)
	ov.ZIndex = host.ZIndex + 50
	ov.Parent = slot

	local ovScale = Instance.new("UIScale")
	ovScale.Scale = 1
	ovScale.Parent = ov
	shrink:GetPropertyChangedSignal("Scale"):Connect(function()
		ovScale.Scale = shrink.Scale
	end)

	host.Parent = slot
	host.AnchorPoint = Vector2.new(0.5, 0)
	host.Position = UDim2.new(0.5, 0, 0, 0)

	-- keep the slot as tall as the element really is (dropdowns open, text grows...)
	local function sync()
		local sc = 1
		local p = slot.Parent
		while p do
			local u = p:FindFirstChildOfClass("UIScale")
			if u then sc *= u.Scale end
			p = p.Parent
		end
		local logical = host.AbsoluteSize.Y / math.max(sc * shrink.Scale, 0.001)
		if logical > 1 and math.abs(slot.Size.Y.Offset - logical) > 0.5 then
			slot.Size = UDim2.new(1, 0, 0, logical)
		end
	end
	host:GetPropertyChangedSignal("AbsoluteSize"):Connect(sync)
	task.defer(sync)

	-- grey cover: a clipping "curtain" with a flat leading edge; the top
	-- corners still match the element's rounded corners
	local function buildFill()
		clip = Instance.new("Frame")
		clip.Name = "HoldClip"
		clip.BackgroundTransparency = 1
		clip.BorderSizePixel = 0
		clip.ClipsDescendants = true
		clip.Size = UDim2.new(1, 0, 0, 0)
		clip.ZIndex = 150
		clip.Parent = ov

		fill = Instance.new("Frame")
		fill.Name = "HoldFill"
		fill.BackgroundColor3 = Color3.fromRGB(125, 125, 125)
		fill.BackgroundTransparency = 1
		fill.BorderSizePixel = 0
		fill.Size = UDim2.new(1, 0, 1, 0)
		fill.ZIndex = 150
		fill.Parent = clip
		corner(fill, UDim.new(0, 12))
	end

	-- p = 0..1 of the element's height
	local function setProgress(p)
		if not clip or not fill then return end
		p = math.clamp(p, 0.0005, 1)
		clip.Size = UDim2.new(1, 0, p, 0)
		fill.Size = UDim2.new(1, 0, 1 / p, 0) -- always the full element height
	end

	local function stopTimers()
		token += 1
		if progTween then progTween:Cancel() progTween = nil end
		if progConn then progConn:Disconnect() progConn = nil end
		if progress then progress:Destroy() progress = nil end
		if shrinkTween then shrinkTween:Cancel() shrinkTween = nil end
		TweenService:Create(shrink, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Scale = 1}):Play()
	end

	local function removeFill(fade)
		local c, f = clip, fill
		clip, fill = nil, nil
		if not c then return end
		if fade and f and f.Parent then
			local t = TweenService:Create(f, TweenInfo.new(0.2), {BackgroundTransparency = 1})
			t:Play()
			t.Completed:Connect(function()
				c:Destroy()
			end)
		else
			c:Destroy()
		end
	end

	local function popIn(obj, time)
		local sc = Instance.new("UIScale")
		sc.Scale = 0
		sc.Parent = obj
		TweenService:Create(sc, TweenInfo.new(time or 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
	end

	local function popOut(obj)
		if not obj then return end
		local sc = obj:FindFirstChildOfClass("UIScale")
		if sc then
			local t = TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = 0})
			t:Play()
			t.Completed:Connect(function()
				obj:Destroy()
			end)
		else
			obj:Destroy()
		end
	end

	local function exitMode()
		if not active then return end
		active = false
		fired = false
		Window.ClickSound:Play()

		popOut(saBtn)
		popOut(xBtn)
		saBtn, xBtn = nil, nil
		if blocker then
			blocker:Destroy()
			blocker = nil
		end
		removeFill(true)
	end

	local function enterMode()
		active = true
		fired = true
		stopTimers()
		setProgress(1)

		-- toony: the element springs back from its shrunk size to normal
		shrink.Scale = 0.95
		TweenService:Create(shrink, TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1}):Play()

		-- sinks input so the element itself is inert until the red x is pressed
		blocker = Instance.new("TextButton")
		blocker.Name = "HoldBlocker"
		blocker.Size = UDim2.new(1, 0, 1, 0)
		blocker.BackgroundTransparency = 1
		blocker.Text = ""
		blocker.AutoButtonColor = false
		blocker.ZIndex = 160
		blocker.Parent = ov

		-- STANDALONE: the same UI button, smaller, solid, with small rounded corners
		saBtn = buildUIButton(ov, "STANDALONE", function()
			Window.ClickSound:Play()
			standaloneSpawned += 1
			local pos = UDim2.new(0.5, 0, 0.08, 0)
			local ok, item = pcall(spec.spawn, pos)
			if ok and item then
				registerStandalone(item)
				Library:CreateNotification("Standalone: " .. tostring(spec.name), 2)
			else
				warn("[UI] Could not create standalone:", item)
			end
			-- the copy exists now: the original goes back to normal (grey cover + buttons gone)
			exitMode()
		end, UDim2.new(0, 120, 0, 30), 0)
		saBtn.Name = "HoldStandalone"
		saBtn.BackgroundTransparency = 0
		local saCorner = saBtn:FindFirstChildOfClass("UICorner")
		if saCorner then saCorner.CornerRadius = UDim.new(0, 6) end
		saBtn.AnchorPoint = Vector2.new(0.5, 0.5)
		saBtn.Position = UDim2.new(0.5, 0, 0.5, 0)
		raise(saBtn, 170)
		popIn(saBtn, 0.5)

		-- small red button with a real, symmetric X (two crossed bars)
		xBtn = Instance.new("TextButton")
		xBtn.Name = "HoldClose"
		xBtn.Size = UDim2.new(0, 26, 0, 26)
		xBtn.AnchorPoint = Vector2.new(0.5, 0.5)
		xBtn.Position = UDim2.new(1, -18, 0, 18)
		xBtn.BackgroundColor3 = Color3.fromRGB(225, 55, 55)
		xBtn.BackgroundTransparency = 0
		xBtn.BorderSizePixel = 0
		xBtn.Text = ""
		xBtn.AutoButtonColor = false
		xBtn.ZIndex = 171
		xBtn.Parent = ov
		corner(xBtn, UDim.new(1, 0))
		stroke(xBtn, 1.5)

		for _, rot in ipairs({45, -45}) do
			local bar = Instance.new("Frame")
			bar.AnchorPoint = Vector2.new(0.5, 0.5)
			bar.Position = UDim2.new(0.5, 0, 0.5, 0)
			bar.Size = UDim2.new(0, 14, 0, 3)
			bar.BackgroundColor3 = Color3.new(1, 1, 1)
			bar.BorderSizePixel = 0
			bar.Rotation = rot
			bar.ZIndex = 172
			bar.Parent = xBtn
			corner(bar, UDim.new(1, 0))
		end

		popIn(xBtn, 0.55)
		xBtn.Activated:Connect(exitMode)
	end

	local function begin(input)
		if active then return end
		if pressed then
			if os.clock() - pressedAt < HOLD_TIME + 2 then return end
			-- a release was missed somewhere: reset and start fresh
			pressed = false
			stopTimers()
			removeFill(false)
		end
		if currentHold and currentHold.hold ~= hold then
			local other = currentHold.hold
			currentHold = nil
			other.release()
		end

		pressed = true
		fired = false
		cancelled = false
		pressedAt = os.clock()
		startPos = Vector2.new(input.Position.X, input.Position.Y)
		currentHold = {hold = hold, input = input, lastPos = startPos}
		token += 1
		local myToken = token

		buildFill()
		setProgress(0)
		-- fades in quickly so quick taps don't flash
		TweenService:Create(fill, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()

		progress = Instance.new("NumberValue")
		progConn = progress.Changed:Connect(setProgress)
		progTween = TweenService:Create(progress, TweenInfo.new(HOLD_TIME, Enum.EasingStyle.Linear), {Value = 1})
		progTween:Play()
		progTween.Completed:Connect(function(state)
			if state ~= Enum.PlaybackState.Completed then return end
			if myToken ~= token or cancelled or not pressed then return end
			enterMode()
		end)

		-- the element slightly shrinks while it is held
		shrinkTween = TweenService:Create(shrink, TweenInfo.new(HOLD_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Scale = 0.95})
		shrinkTween:Play()
	end

	function hold.release()
		pressed = false
		if not fired and not active then
			stopTimers()
			removeFill(true)
		end
	end

	function hold.moved(pos)
		if cancelled or fired or active or not pressed then return end
		if (pos - startPos).Magnitude > HOLD_MOVE_LIMIT then
			cancelled = true
			stopTimers()
			removeFill(true)
		end
	end

	-- elements check this so a completed hold doesn't also "click" them
	function hold.wasFired()
		return fired or active
	end

	function hold.bind(obj)
		if bound[obj] then return end
		bound[obj] = true
		obj.InputBegan:Connect(function(input)
			if isPress(input) then
				begin(input)
			end
		end)
	end

	-- bind EVERY part of the element (boxes, labels, text boxes, buttons) so a
	-- hold starts no matter which part of the element you touch
	for _, d in ipairs(host:GetDescendants()) do
		if d:IsA("GuiObject") then
			hold.bind(d)
		end
	end
	host.DescendantAdded:Connect(function(d)
		if d:IsA("GuiObject") and not string.find(d.Name, "^Hold") then
			hold.bind(d)
		end
	end)
	hold.bind(host)

	return hold
end

