-- helpers ---------------------------------------------------------------
local function corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = r
	c.Parent = obj
	return c
end

local function stroke(obj, thickness, color)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness
	s.Color = color or Color3.new(0, 0, 0)
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = obj
	return s
end

local function safe(cb, ...)
	if cb then
		local ok, err = pcall(cb, ...)
		if not ok then
			warn("[UI Callback Error]", err)
		end
	end
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

-- dropdowns show at most this many options; more options = the list scrolls
local DROPDOWN_MAX_VISIBLE = 5

-- standalone copies: a drag must never also count as a tap
local DragState = {lastEnd = 0}
function DragState.guard()
	return os.clock() - DragState.lastEnd < 0.25
end

----------------------------------------------------------------------
-- STANDALONE COMPONENTS
-- Each one creates its own ScreenGui. Call with a dot, not a colon:
--   Library.CreateToggle({ label = "Fly", callback = function(on) end })
-- Pass `position` to place them (they all anchor at top-center).
----------------------------------------------------------------------
local standaloneCounter = 0
local standaloneGuis = {} -- every standalone ScreenGui ever made (cleaned up when the X is pressed)

local function createScreenGui(name)
	standaloneCounter += 1
	local gui = Instance.new("ScreenGui")
	gui.Name = name .. "_" .. standaloneCounter
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	table.insert(standaloneGuis, gui)
	return gui
end

-- destroys every standalone ScreenGui (also the ones created directly with Library.CreateXxx)
function Library.DestroyAllStandaloneGuis()
	for _, g in ipairs(standaloneGuis) do
		pcall(function() g:Destroy() end)
	end
	table.clear(standaloneGuis)
end

-- keeps a component at most 440px wide but shrinks on small screens
local function limitWidth(obj, maxWidth)
	local c = Instance.new("UISizeConstraint")
	c.MaxSize = Vector2.new(maxWidth, math.huge)
	c.Parent = obj
end

local function newConnectionBag(gui)
	local bag = {}
	gui.Destroying:Connect(function()
		for _, c in ipairs(bag) do
			pcall(function() c:Disconnect() end)
		end
		table.clear(bag)
	end)
	return function(c)
		table.insert(bag, c)
		return c
	end
end

-- 1) Toggle ------------------------------------------------------------
function Library.CreateToggle(config)
	config = config or {}
	local label = config.label or "Toggle"
	local toggled = config.defaultState or false
	local position = config.position or UDim2.new(0.5, 0, 0.1, 0)
	local callback = config.callback

	local gui = createScreenGui("ToggleGui")

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0.9, 0, 0, 50)
	frame.Position = position
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
	frame.BorderSizePixel = 0
	frame.Parent = gui
	limitWidth(frame, 440)
	corner(frame, UDim.new(0, 12))
	stroke(frame, 2)

	local labelText = Instance.new("TextLabel")
	labelText.Size = UDim2.new(1, -90, 1, 0)
	labelText.Position = UDim2.new(0, 12, 0, 0)
	labelText.BackgroundTransparency = 1
	labelText.Text = label
	labelText.Font = Enum.Font.GothamBold
	labelText.TextSize = 18
	labelText.TextColor3 = Color3.new(0, 0, 0)
	labelText.TextXAlignment = Enum.TextXAlignment.Left
	labelText.TextTruncate = Enum.TextTruncate.AtEnd
	labelText.Parent = frame

	local toggleFrame = Instance.new("Frame")
	toggleFrame.Size = UDim2.new(0, 60, 0, 30)
	toggleFrame.Position = UDim2.new(1, -70, 0.5, 0)
	toggleFrame.AnchorPoint = Vector2.new(0, 0.5)
	toggleFrame.BorderSizePixel = 0
	toggleFrame.Parent = frame
	corner(toggleFrame, UDim.new(1, 0))

	local circle = Instance.new("Frame")
	circle.Size = UDim2.new(0, 26, 0, 26)
	circle.BorderSizePixel = 0
	circle.Parent = toggleFrame
	corner(circle, UDim.new(1, 0))

	local function applyVisual(animate)
		local pos = toggled and UDim2.new(1, -28, 0.5, -13) or UDim2.new(0, 2, 0.5, -13)
		local bg = toggled and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
		local dot = toggled and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
		if animate then
			local info = TweenInfo.new(0.25)
			TweenService:Create(circle, info, {Position = pos, BackgroundColor3 = dot}):Play()
			TweenService:Create(toggleFrame, info, {BackgroundColor3 = bg}):Play()
		else
			circle.Position, circle.BackgroundColor3 = pos, dot
			toggleFrame.BackgroundColor3 = bg
		end
	end

	applyVisual(false)

	local function setToggle(state, silent)
		state = state and true or false
		if state == toggled then return end
		toggled = state
		applyVisual(true)
		if not silent then safe(callback, toggled) end
	end

	-- only the switch itself toggles (not the name or the row behind it)
	local hit = Instance.new("TextButton")
	hit.Size = UDim2.new(1, 0, 1, 0)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.ZIndex = 5
	hit.Parent = toggleFrame
	hit.Activated:Connect(function()
		if DragState.guard() then return end
		setToggle(not toggled)
	end)

	return {
		frame = frame,
		isToggled = function() return toggled end,
		setToggle = setToggle,
		toggle = function() setToggle(not toggled) end,
		destroy = function() gui:Destroy() end
	}
end

-- 2) Slider ------------------------------------------------------------
function Library.CreateSlider(config)
	config = config or {}
	local label = config.label or "Slider"
	local min = config.min or 0
	local max = config.max or 100
	local position = config.position or UDim2.new(0.5, 0, 0.1, 0)
	local callback = config.callback
	local range = math.max(max - min, 1)
	local value = math.clamp(config.default or min, min, max)

	local gui = createScreenGui("SliderGui")
	local track = newConnectionBag(gui)

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0.9, 0, 0, 50)
	frame.Position = position
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
	frame.BorderSizePixel = 0
	frame.Parent = gui
	limitWidth(frame, 440)
	corner(frame, UDim.new(0, 12))
	stroke(frame, 2)

	local labelText = Instance.new("TextLabel")
	labelText.Size = UDim2.new(0, 130, 1, 0)
	labelText.Position = UDim2.new(0, 12, 0, 0)
	labelText.BackgroundTransparency = 1
	labelText.Font = Enum.Font.GothamBold
	labelText.TextSize = 16
	labelText.TextColor3 = Color3.new(0, 0, 0)
	labelText.TextXAlignment = Enum.TextXAlignment.Left
	labelText.TextTruncate = Enum.TextTruncate.AtEnd
	labelText.Parent = frame

	local sliderBar = Instance.new("Frame")
	sliderBar.Size = UDim2.new(1, -165, 0, 10)
	sliderBar.Position = UDim2.new(0, 150, 0.5, 0)
	sliderBar.AnchorPoint = Vector2.new(0, 0.5)
	sliderBar.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
	sliderBar.BorderSizePixel = 0
	sliderBar.Parent = frame
	corner(sliderBar, UDim.new(1, 0))

	local sliderFill = Instance.new("Frame")
	sliderFill.Size = UDim2.new(0, 0, 1, 0)
	sliderFill.BackgroundColor3 = Color3.new(0, 0, 0)
	sliderFill.BorderSizePixel = 0
	sliderFill.Parent = sliderBar
	corner(sliderFill, UDim.new(1, 0))

	-- bigger invisible touch area so it's easy to grab on phones
	local hitbox = Instance.new("TextButton")
	hitbox.Size = UDim2.new(1, 0, 0, 34)
	hitbox.Position = UDim2.new(0, 0, 0.5, 0)
	hitbox.AnchorPoint = Vector2.new(0, 0.5)
	hitbox.BackgroundTransparency = 1
	hitbox.BorderSizePixel = 0
	hitbox.Parent = sliderBar
	hitbox.Text = ""
	hitbox.AutoButtonColor = false
	hitbox:SetAttribute("NoDrag", true) -- moving the slider must not move the copy

	local function render()
		sliderFill.Size = UDim2.new((value - min) / range, 0, 1, 0)
		labelText.Text = label .. ": " .. value
	end
	render()

	local function setValue(v, silent)
		v = math.clamp(math.floor(v + 0.5), min, max)
		value = v
		render()
		if not silent then safe(callback, value) end
	end

	local dragging = false

	local function updateFromInput(input)
		local pct = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
		setValue(min + (max - min) * pct)
	end

	hitbox.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			updateFromInput(input)
		end
	end)

	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input)
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if dragging and isPress(input) then
			dragging = false
		end
	end))

	return {
		frame = frame,
		setValue = setValue,
		getValue = function() return value end,
		destroy = function() gui:Destroy() end
	}
end

