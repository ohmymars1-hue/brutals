	----------------------------------------------------------------------
	local isShrunk = false
	local originalMainPos = mainFrame.Position
	local originalGreyPos = GreyLine.Position
	local lastDragTime = 0
	local drag = nil -- { input, lastPos, pressPos, startPos, startCenter, active }

	GreyHit.InputBegan:Connect(function(input)
		if isShrunk or not isPress(input) then return end
		local p = Vector2.new(input.Position.X, input.Position.Y)
		drag = {
			input = input,
			lastPos = p,
			pressPos = p,
			startPos = mainFrame.Position,
			startCenter = mainFrame.AbsolutePosition + mainFrame.AbsoluteSize / 2,
			active = false,
		}
	end)

	track(UserInputService.InputChanged:Connect(function(input)
		local d = drag
		if not d or isShrunk then return end
		if not isMoveOf(d.input, d.lastPos, input) then return end

		local cur = Vector2.new(input.Position.X, input.Position.Y)
		d.lastPos = cur
		if not d.active then
			if (cur - d.pressPos).Magnitude < DRAG_START then return end
			d.active = true
			d.pressPos = cur -- start from here so the window never jumps
		end
		lastDragTime = os.clock()

		-- set the position directly on every move (no tween) = follows the finger exactly
		local vp = cam.ViewportSize
		local target = d.startCenter + (cur - d.pressPos)
		local clamped = Vector2.new(
			math.clamp(target.X, 40, vp.X - 40),
			math.clamp(target.Y, 40, vp.Y - 40))
		local fix = clamped - d.startCenter
		mainFrame.Position = UDim2.new(
			d.startPos.X.Scale, d.startPos.X.Offset + fix.X,
			d.startPos.Y.Scale, d.startPos.Y.Offset + fix.Y)
