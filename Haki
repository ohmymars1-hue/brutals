			h.ZIndex = 99
			h.LayoutOrder = order
			h.Parent = sf

			local pill = Instance.new("Frame")
			pill.Size = UDim2.new(0, math.min(textW + 26, 300), 0, 24)
			pill.Position = UDim2.new(0, 4, 0.5, 0)
			pill.AnchorPoint = Vector2.new(0, 0.5)
