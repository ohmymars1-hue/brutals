			lbl.TextColor3 = Color3.new(0, 0, 0)
			lbl.TextTruncate = Enum.TextTruncate.AtEnd
			lbl.ZIndex = 100
			lbl.Parent = pill

			return h
		end

		-- wraps a real row in an indented frame and draws the tree line:
		--   |__[component]
		-- isFirst: the line also reaches up to the tab name; isLast: the line stops at the branch
		local function makeTreeRow(row, order, isFirst, isLast)
			local wrap = Instance.new("Frame")
			wrap.Name = "SearchTreeRow"
			wrap.Size = UDim2.new(1, 0, 0, 0)
			wrap.AutomaticSize = Enum.AutomaticSize.Y
			wrap.BackgroundTransparency = 1
			wrap.BorderSizePixel = 0
			wrap.ZIndex = 99
			wrap.LayoutOrder = order
			wrap.Parent = sf

			local pad = Instance.new("UIPadding")
			pad.PaddingLeft = UDim.new(0, TREE_INDENT)
			pad.Parent = wrap

			local topExtra = isFirst and 10 or 0 -- reaches the tab name above

			-- vertical line
			local vline = Instance.new("Frame")
			vline.Name = "TreeLine"
			vline.BackgroundColor3 = Color3.new(0, 0, 0)
			vline.BorderSizePixel = 0
			vline.ZIndex = 100
			vline.Position = UDim2.new(0, TREE_X, 0, -topExtra)
			if isLast then
				vline.Size = UDim2.new(0, 2, 0, TREE_BRANCH_Y + 2 + topExtra)
			else
				vline.Size = UDim2.new(0, 2, 1, topExtra + 8) -- +8 fills the gap to the next row
			end
			vline.Parent = wrap

			-- horizontal branch ("__")
			local branch = Instance.new("Frame")
			branch.Name = "TreeBranch"
			branch.BackgroundColor3 = Color3.new(0, 0, 0)
			branch.BorderSizePixel = 0
			branch.ZIndex = 100
			branch.Position = UDim2.new(0, TREE_X, 0, TREE_BRANCH_Y)
			branch.Size = UDim2.new(0, 14, 0, 2)
			branch.Parent = wrap

			row.Parent = wrap
			return wrap
		end

		local function restoreAll()
			for i = #moved, 1, -1 do
				local row = moved[i]
				local o = searchOrigins[row]
				if o then
					pcall(function()
						row.LayoutOrder = o.order
						row.Position = o.position
						row.Parent = o.parent
					end)
					searchOrigins[row] = nil
				end
			end
			table.clear(moved)
			-- the rows are back home, now the tree frames can go
			for _, w in ipairs(wrappers) do
				pcall(function() w:Destroy() end)
			end
			table.clear(wrappers)
			for _, h in ipairs(headers) do
				pcall(function() h:Destroy() end)
			end
			table.clear(headers)
			noResults.Visible = false
		end

		local function apply()
			restoreAll()
			clear.Visible = box.Text ~= ""

			local q = string.match(string.lower(box.Text), "^%s*(.-)%s*$") or ""
			if q == "" or not isActive() then return end

			-- only one search bar may show results at a time
			if activeRestore and activeRestore ~= restoreAll then
				activeRestore()
			end
			activeRestore = restoreAll

			local n = 0
			for _, t in ipairs(getTabs()) do
				-- collect the matches of this tab first (so we know which one is the last)
				local matches = {}
				for _, e in ipairs(t.Elements) do
					if e.kind ~= "sep" and string.find(string.lower(e.text), q, 1, true) then
						table.insert(matches, e)
					end
				end

				if #matches > 0 then
					n += 1
					table.insert(headers, makeHeader(t.Name, base + n))

					for i, e in ipairs(matches) do
						local row = rowOf(e.obj)
						n += 1
						if not searchOrigins[row] then
							searchOrigins[row] = {parent = row.Parent, order = row.LayoutOrder, position = row.Position}
						end
						table.insert(moved, row)
						row.LayoutOrder = 0
						row.Position = UDim2.new(0, 0, 0, 0)
						table.insert(wrappers, makeTreeRow(row, base + n, i == 1, i == #matches))
					end
				end
			end
			noResults.Visible = (n == 0)
			sf.CanvasPosition = Vector2.zero
		end

		box:GetPropertyChangedSignal("Text"):Connect(apply)
		clear.Activated:Connect(function()
			box.Text = ""
			box:ReleaseFocus()
		end)

		-- leaving the tab (other tab / other slide) puts every element back where it belongs
		sf:GetPropertyChangedSignal("Visible"):Connect(apply)
		settingsTabsContainer:GetPropertyChangedSignal("Visible"):Connect(apply)
		Window.Gui.Destroying:Connect(restoreAll)
	end

