		end
	end
	tintTab("UNIVERSAL", Color3.fromRGB(255, 222, 125), Color3.new(1, 1, 1))   -- golden + white
	tintTab("SETTINGS", Color3.fromRGB(150, 195, 255), Color3.new(1, 1, 1))    -- smooth blue + white
	tintTab("UPDATES", Color3.fromRGB(60, 60, 60), Color3.new(1, 1, 1))        -- black + white
	tintTab("INFO", Color3.fromRGB(175, 175, 182), Color3.new(1, 1, 1))        -- smooth grey + white
	tintTab("FEEDBACK", Color3.fromRGB(110, 210, 135), Color3.new(1, 1, 1))    -- green + white

	-- only the owner can get this tab from outside the library
	function Window:GetUniversalTab()
		if isWhitelisted then
			return universalTab
		end
		warn("[UI] The Universal section is locked (owner only).")
		return nil
	end

	return Window
end

----------------------------------------------------------------------
-- Notifications (rounded corners, no stacking on top of each other)
----------------------------------------------------------------------
function Library:CreateNotification(text, duration)
	local player = Players.LocalPlayer
	duration = duration or 5
	text = tostring(text)

	local playerGui = player:WaitForChild("PlayerGui")

	-- replace any notification that's still showing so they don't overlap
	local old = playerGui:FindFirstChild("CustomNotification")
	if old then old:Destroy() end

	local gui = Instance.new("ScreenGui")
	gui.Name = "CustomNotification"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = playerGui

	-- long messages get a taller box so the text stays readable
	local tall = #text > 45

	local notifFrame = Instance.new("Frame")
	notifFrame.Name = "NotifFrame"
	notifFrame.Size = UDim2.new(tall and 0.7 or 0.6, 0, tall and 0.2 or 0.11, 0)
	notifFrame.Position = UDim2.new(0.5, 0, tall and 0.85 or 0.93, 0)
	notifFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	notifFrame.BackgroundColor3 = Color3.new(1, 1, 1)
	notifFrame.BorderSizePixel = 0
	notifFrame.ClipsDescendants = true
	notifFrame.Parent = gui

	-- ROUNDER CORNERS
	corner(notifFrame, UDim.new(0, 22))

	local scale = Instance.new("UIScale")
	scale.Scale = 0
	scale.Parent = notifFrame

	stroke(notifFrame, 1.5, Color3.fromRGB(100, 100, 100))

	local notifText = Instance.new("TextLabel")
	notifText.Size = UDim2.new(1, -36, 1, -22)
	notifText.Position = UDim2.new(0, 18, 0, 8)
	notifText.BackgroundTransparency = 1
	notifText.Text = text
	notifText.TextColor3 = Color3.new(0, 0, 0)
	notifText.Font = Enum.Font.Gotham
	notifText.TextSize = 22
	notifText.TextWrapped = true
	notifText.TextScaled = true
	local notifConstraint = Instance.new("UITextSizeConstraint")
	notifConstraint.MinTextSize = 10
	notifConstraint.MaxTextSize = 22
	notifConstraint.Parent = notifText
	notifText.TextXAlignment = Enum.TextXAlignment.Left
	notifText.TextYAlignment = Enum.TextYAlignment.Center
	notifText.Parent = notifFrame

	-- Cooldown line: inset + rounded so it follows the rounded shape
	local cooldownLine = Instance.new("Frame")
	cooldownLine.Name = "CooldownLine"
	cooldownLine.BackgroundColor3 = Color3.new(0, 0, 0)
	cooldownLine.BorderSizePixel = 0
	cooldownLine.AnchorPoint = Vector2.new(0.5, 1)
	cooldownLine.Position = UDim2.new(0.5, 0, 1, -7)
	cooldownLine.Size = UDim2.new(1, -44, 0, 4)
	cooldownLine.Parent = notifFrame
	corner(cooldownLine, UDim.new(1, 0))

	TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back), {Scale = 1}):Play()

	task.delay(0.4, function()
		if not cooldownLine.Parent then return end
		local cooldownTween = TweenService:Create(cooldownLine,
			TweenInfo.new(duration, Enum.EasingStyle.Linear),
			{Size = UDim2.new(0, 0, 0, 4)}
		)
		cooldownTween:Play()
		cooldownTween.Completed:Connect(function()
			if not gui.Parent then return end
			local shrinkTween = TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Quad), {Scale = 0})
			shrinkTween:Play()
			shrinkTween.Completed:Connect(function()
				gui:Destroy()
			end)
		end)
	end)
end

return Library
