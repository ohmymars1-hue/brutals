		settingsBusy = true
		settingsToken += 1
		local myToken = settingsToken

		if not settingsOpen then
			settingsOpen = true
			Window.SettingsOpen = true

			TweenService:Create(settingsIcon, TweenInfo.new(0.4, Enum.EasingStyle.Back), {Rotation = -25}):Play()

			-- the page you are on slides down and out...
			local outgoing = nil
			currentVisibleTab = nil
			for sectionName, sectionFrame in pairs(Window.Sections) do
				if sectionFrame.Visible then
					currentVisibleTab = sectionName
					savedScrollPositions[sectionName] = sectionFrame.CanvasPosition
					outgoing = sectionFrame
				end
			end
			if outgoing then
				TweenService:Create(outgoing, pageInfo, {Position = PAGE_BELOW}):Play()
			end

			-- ...while the settings page slides in from the top
			for name, frame in pairs(settingsTabs) do
				frame.Visible = (name == "UNIVERSAL") -- opens on UNIVERSAL (first tab)
			end
			settingsTabsContainer.Visible = true
			settingsTabsContainer.Position = SETTINGS_ABOVE
			TweenService:Create(settingsTabsContainer, pageInfo, {Position = SETTINGS_HOME}):Play()

			swapSidebar(true)

			task.delay(PAGE_TIME, function()
				if outgoing then
					outgoing.Visible = false
					outgoing.Position = PAGE_HOME
				end
				settingsBusy = false
			end)
		else
			settingsOpen = false
			Window.SettingsOpen = false

			TweenService:Create(settingsIcon, TweenInfo.new(0.4, Enum.EasingStyle.Back), {Rotation = 0}):Play()

			-- the settings page slides up and out...
			TweenService:Create(settingsTabsContainer, pageInfo, {Position = SETTINGS_ABOVE}):Play()

			-- ...while your page glides back in from below
			local incoming = currentVisibleTab and Window.Sections[currentVisibleTab]
			if incoming then
				incoming.Position = PAGE_BELOW
				if savedScrollPositions[currentVisibleTab] then
					incoming.CanvasPosition = savedScrollPositions[currentVisibleTab]
				end
				incoming.Visible = true
				TweenService:Create(incoming, pageInfo, {Position = PAGE_HOME}):Play()
			end

			swapSidebar(false)

			task.delay(PAGE_TIME, function()
				settingsBusy = false
				if myToken ~= settingsToken or settingsOpen then return end
				settingsTabsContainer.Visible = false
			end)
		end
	end)

