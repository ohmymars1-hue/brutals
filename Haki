	local PAGE_TIME = 0.5
	local pageInfo = TweenInfo.new(PAGE_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
	local PAGE_HOME = UDim2.new(0, 10, 0, 10)
	local PAGE_BELOW = UDim2.new(0, 10, 0, 285)
