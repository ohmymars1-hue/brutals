			local listeners = {}

			-- one place that changes the value: updates this slider, fires the
			-- callback and mirrors the value to every standalone copy
			local function setValue(v)
				v = math.clamp(math.floor(v + 0.5), min, max)
				currentValue = v
				sliderFill.Size = UDim2.new((v - min) / range, 0, 1, 0)
				numberLabel.Text = tostring(v)
				safe(callback, v)
				for i = #listeners, 1, -1 do
					if not listeners[i](v) then table.remove(listeners, i) end
				end
			end

			local function updateSlider(input)
				local trackPos = sliderTrack.AbsolutePosition.X
				local trackSize = sliderTrack.AbsoluteSize.X
				local percentage = math.clamp((input.Position.X - trackPos) / trackSize, 0, 1)
				setValue(min + (max - min) * percentage)
			end

			sliderTrack.InputBegan:Connect(function(input)
				if isPress(input) then
					dragging = true
					dragScroller = sliderContainer:FindFirstAncestorWhichIsA("ScrollingFrame")
					if dragScroller then dragScroller.ScrollingEnabled = false end -- don't scroll while dragging
					updateSlider(input)
				end
			end)

			track(UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch) then
					updateSlider(input)
				end
			end))

			track(UserInputService.InputEnded:Connect(function(input)
				if isPress(input) then
					dragging = false
					if dragScroller then
						dragScroller.ScrollingEnabled = true
						dragScroller = nil
					end
				end
			end))

			numberLabel.FocusLost:Connect(function()
				local inputValue = tonumber(numberLabel.Text)
				if inputValue then
					setValue(inputValue) -- rounds + clamps like dragging does
				else
					numberLabel.Text = tostring(currentValue)
				end
			end)

			local hold = makeHold(Window, sliderContainer, sliderContainer, {
				name = text,
				spawn = function(pos)
					local item
					item = Library.CreateSlider({
						label = text, min = min, max = max, default = currentValue, position = pos,
						callback = function(v) setValue(v) end -- copy -> original (+ other copies)
					})
					table.insert(listeners, function(v) -- original -> copy
						if not item.frame:IsDescendantOf(game) then return false end
						item.setValue(v, true)
						return true
					end)
					return item
				end
			})
			hold.bind(sliderContainer)
			hold.bind(sliderTrack)

			return register(sliderContainer, text)
		end

		function Tab:AddSeparator(text)
			Tab.ElementCount = Tab.ElementCount + 1
			local sep = makeSeparator(scrollFrame, text or "GROUP", Tab.ElementCount)
