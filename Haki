		function Tab:AddToggle(text, default, callback)
			Tab.ElementCount = Tab.ElementCount + 1

			local toggleBox = Instance.new("Frame")
			toggleBox.Size = UDim2.new(1, 0, 0, 50)
			toggleBox.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
			toggleBox.BorderSizePixel = 0
			toggleBox.ZIndex = 99
			toggleBox.LayoutOrder = Tab.ElementCount
			toggleBox.Parent = scrollFrame
			corner(toggleBox, UDim.new(0, 12))
			stroke(toggleBox, 2)

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, -80, 1, 0)
			label.Position = UDim2.new(0, 10, 0, 0)
			label.BackgroundTransparency = 1
			label.Text = text
			label.Font = Enum.Font.GothamBold
			label.TextSize = 16
			label.TextColor3 = Color3.new(0, 0, 0)
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.TextYAlignment = Enum.TextYAlignment.Center
			label.TextWrapped = true
			label.TextScaled = true
			label.ZIndex = 99
			label.Parent = toggleBox

			local c = Instance.new("UITextSizeConstraint")
			c.MinTextSize = 10
			c.MaxTextSize = 16
			c.Parent = label

			local toggled = default or false
			local listeners = {}

			local toggleFrame = Instance.new("Frame")
			toggleFrame.Size = UDim2.new(0, 60, 0, 30)
			toggleFrame.Position = UDim2.new(1, -70, 0.5, 0)
			toggleFrame.AnchorPoint = Vector2.new(0, 0.5)
			toggleFrame.BackgroundColor3 = toggled and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
			toggleFrame.BorderSizePixel = 0
			toggleFrame.ZIndex = 99
			toggleFrame.Parent = toggleBox
			corner(toggleFrame, UDim.new(1, 0))

			local circle = Instance.new("Frame")
			circle.Size = UDim2.new(0, 26, 0, 26)
			circle.Position = toggled and UDim2.new(1, -28, 0.5, -13) or UDim2.new(0, 2, 0.5, -13)
			circle.BackgroundColor3 = toggled and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
			circle.BorderSizePixel = 0
			circle.ZIndex = 100
			circle.Parent = toggleFrame
			corner(circle, UDim.new(1, 0))

			local function setToggle(state)
				state = state and true or false
				if state == toggled then return end
				toggled = state

				local info = TweenInfo.new(0.25)
				TweenService:Create(circle, info, {
					Position = toggled and UDim2.new(1, -28, 0.5, -13) or UDim2.new(0, 2, 0.5, -13),
					BackgroundColor3 = toggled and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
				}):Play()
				TweenService:Create(toggleFrame, info, {
					BackgroundColor3 = toggled and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
				}):Play()

				Window.ClickSound:Play()
				safe(callback, toggled)
				for i = #listeners, 1, -1 do
					if not listeners[i](toggled) then table.remove(listeners, i) end
				end
			end

			local api = {
				set = setToggle,
				get = function() return toggled end,
			}
			table.insert(allToggles, api) -- the X button switches every enabled toggle off again

			local hit = Instance.new("TextButton")
			hit.Name = "SwitchHit"
			hit.Size = UDim2.new(1, 0, 1, 0)
			hit.BackgroundTransparency = 1
			hit.Text = ""
			hit.AutoButtonColor = false
			hit.ZIndex = 101
			hit.Parent = toggleFrame

			local hold = makeHold(Window, toggleBox, toggleBox, {
				name = text,
				spawn = function(pos)
					local item
					item = Library.CreateToggle({
						label = text, defaultState = toggled, position = pos,
						callback = function(s) setToggle(s) end -- copy -> original (+ other copies)
					})
					table.insert(listeners, function(s) -- original -> copy
						if not item.frame:IsDescendantOf(game) then return false end
						item.setToggle(s, true)
						return true
					end)
					return item
				end
			})
			hold.bind(toggleBox)
			hold.bind(hit)

			-- only the switch itself toggles (not the name or the row behind it)
			hit.Activated:Connect(function()
				if hold.wasFired() then return end
				setToggle(not toggled)
			end)

			register(toggleBox, text)
			return toggleBox, api
		end

		-- shared dropdown builder (multi = checkbox style, otherwise single select)
		-- The original and every STANDALONE copy always show the same selection.
		-- At most DROPDOWN_MAX_VISIBLE (5) options are visible, more options scroll.
		local function buildDropdown(text, options, default, callback, multi)
			Tab.ElementCount = Tab.ElementCount + 1

			local collapsedHeight = 90
			local optionHeight = 35
			local scrollable = #options > DROPDOWN_MAX_VISIBLE
			local listHeight = math.min(#options, DROPDOWN_MAX_VISIBLE) * optionHeight

			local dropdownContainer = Instance.new("Frame")
			dropdownContainer.Size = UDim2.new(1, 0, 0, collapsedHeight)
			dropdownContainer.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
			dropdownContainer.BorderSizePixel = 0
			dropdownContainer.ZIndex = 99
			dropdownContainer.LayoutOrder = Tab.ElementCount
			dropdownContainer.ClipsDescendants = false
			dropdownContainer.Parent = scrollFrame
			corner(dropdownContainer, UDim.new(0, 12))
			stroke(dropdownContainer, 2)

			local dropdownLabel = Instance.new("TextLabel")
			dropdownLabel.Size = UDim2.new(0, 150, 0, 25)
			dropdownLabel.Position = UDim2.new(0, 10, 0, 5)
			dropdownLabel.BackgroundTransparency = 1
			dropdownLabel.Text = text
			dropdownLabel.Font = Enum.Font.GothamBold
			dropdownLabel.TextSize = 20
			dropdownLabel.TextColor3 = Color3.new(0, 0, 0)
			dropdownLabel.TextXAlignment = Enum.TextXAlignment.Left
			dropdownLabel.ZIndex = 99
			dropdownLabel.Parent = dropdownContainer

			local firstBox = Instance.new("Frame")
			firstBox.Name = "DropdownContainer"
			firstBox.Size = UDim2.new(1, -20, 0, 45)
			firstBox.Position = UDim2.new(0.5, 0, 0, 35)
			firstBox.AnchorPoint = Vector2.new(0.5, 0)
			firstBox.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
			firstBox.BackgroundTransparency = 0.2
			firstBox.BorderSizePixel = 0
			firstBox.ZIndex = 99
			firstBox.ClipsDescendants = false
			firstBox.Parent = dropdownContainer
			corner(firstBox, UDim.new(0, 4))
			stroke(firstBox, 1)

			local selectionBox = Instance.new("TextButton")
			selectionBox.Name = "SelectionBox"
			selectionBox.Size = UDim2.new(1, -20, 1, -10)
			selectionBox.Position = UDim2.new(0, 10, 0.5, 0)
			selectionBox.AnchorPoint = Vector2.new(0, 0.5)
			selectionBox.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
			selectionBox.BorderSizePixel = 0
			selectionBox.Text = ""
			selectionBox.Font = Enum.Font.Gotham
			selectionBox.TextSize = 14
			selectionBox.TextColor3 = Color3.new(0, 0, 0)
			selectionBox.TextXAlignment = Enum.TextXAlignment.Left
			selectionBox.TextWrapped = true
			selectionBox.TextScaled = true
			local selConstraint = Instance.new("UITextSizeConstraint")
			selConstraint.MinTextSize = 8
			selConstraint.MaxTextSize = 14
			selConstraint.Parent = selectionBox
			selectionBox.AutoButtonColor = false
			selectionBox.ZIndex = 100
			selectionBox.Parent = firstBox

			local textPadding = Instance.new("UIPadding")
			textPadding.PaddingLeft = UDim.new(0, 8)
			textPadding.PaddingRight = UDim.new(0, 8)
			textPadding.Parent = selectionBox
			corner(selectionBox, UDim.new(0, 4))
			stroke(selectionBox, 1)

			local dropdownFrame = Instance.new("Frame")
			dropdownFrame.Name = "DropdownOptions"
			dropdownFrame.Size = UDim2.new(1, -20, 0, 0)
			dropdownFrame.Position = UDim2.new(0, 10, 1, 5)
			dropdownFrame.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
			dropdownFrame.BackgroundTransparency = 0.2
			dropdownFrame.BorderSizePixel = 0
			dropdownFrame.Visible = false
			dropdownFrame.ClipsDescendants = true
			dropdownFrame.ZIndex = 102
			dropdownFrame.Parent = firstBox
			corner(dropdownFrame, UDim.new(0, 4))
			stroke(dropdownFrame, 1)

			-- the options live in a scrolling frame: more than 5 options = scroll
			local optionScroll = Instance.new("ScrollingFrame")
			optionScroll.Name = "OptionScroll"
			optionScroll.Size = UDim2.new(1, 0, 1, 0)
			optionScroll.BackgroundTransparency = 1
			optionScroll.BorderSizePixel = 0
			optionScroll.ScrollBarThickness = scrollable and 4 or 0
			optionScroll.ScrollBarImageColor3 = Color3.new(0, 0, 0)
			optionScroll.CanvasSize = UDim2.new(0, 0, 0, #options * optionHeight)
			optionScroll.ScrollingDirection = Enum.ScrollingDirection.Y
			optionScroll.ZIndex = 103
			optionScroll.Parent = dropdownFrame

			-- state
			local isOpen = false
			local selectedParts = {}
			local selectedOption = (not multi) and (default or options[1]) or nil
			local optionRows = {}
			local listeners = {}

			local function isSelected(n)
				return table.find(selectedParts, n) ~= nil
			end

			local function refresh(animate)
				for name, r in pairs(optionRows) do
					if multi then
						local on = isSelected(name)
						r.dot.Size = UDim2.new(0, 8, 0, 8)
						r.dot.BackgroundColor3 = on and Color3.fromRGB(128, 128, 128) or Color3.new(0, 0, 0)
						r.button.BackgroundColor3 = on and Color3.fromRGB(210, 210, 210) or Color3.fromRGB(245, 245, 245)
					else
						local size = (name == selectedOption) and UDim2.new(0, 8, 0, 8) or UDim2.new(0, 4, 0, 4)
						if animate then
							TweenService:Create(r.dot, TweenInfo.new(0.25), {Size = size}):Play()
						else
							r.dot.Size = size
						end
					end
				end
				if multi then
					selectionBox.Text = table.concat(selectedParts, ", ")
				else
					selectionBox.Text = selectedOption or ""
				end
			end

			-- the ONE place the selection changes (original or copy):
			-- updates visuals, fires the callback, mirrors to every standalone copy
			local function setState(v, silent)
				if multi then
					selectedParts = {}
					if type(v) == "table" then
						for _, n in ipairs(v) do
							if table.find(options, n) and not isSelected(n) then
								table.insert(selectedParts, n)
							end
						end
					end
				elseif v ~= nil and table.find(options, v) then
					selectedOption = v
				end
				refresh(true)

				local snap = multi and table.clone(selectedParts) or selectedOption
				if not silent then safe(callback, snap) end
				for i = #listeners, 1, -1 do
					if not listeners[i](snap) then table.remove(listeners, i) end
				end
			end

			local function closeDropdown()
				if not isOpen then return end
				isOpen = false
				local closeTween = TweenService:Create(dropdownFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -20, 0, 0)})
				TweenService:Create(dropdownContainer, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, collapsedHeight)}):Play()
				closeTween:Play()
				closeTween.Completed:Connect(function()
					if not isOpen then dropdownFrame.Visible = false end
				end)
			end

			local function openDropdown()
				isOpen = true
				dropdownFrame.Visible = true
				dropdownFrame.Size = UDim2.new(1, -20, 0, 0)
				TweenService:Create(dropdownFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -20, 0, listHeight)}):Play()
				TweenService:Create(dropdownContainer, TweenInfo.new(0.2), {
					Size = UDim2.new(1, 0, 0, collapsedHeight + listHeight + 10)
				}):Play()
			end

			for i, optionName in ipairs(options) do
				local optionButton = Instance.new("TextButton")
				optionButton.Name = optionName
				optionButton.Size = UDim2.new(1, scrollable and -6 or 0, 0, optionHeight)
				optionButton.Position = UDim2.new(0, 0, 0, (i - 1) * optionHeight)
				optionButton.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
				optionButton.BorderSizePixel = 0
				optionButton.Text = ""
				optionButton.AutoButtonColor = false
				optionButton.ZIndex = 103
				optionButton.Parent = optionScroll

				if i < #options then
					local separator = Instance.new("Frame")
					separator.Name = "Separator"
					separator.Size = UDim2.new(1, 0, 0, 1)
					separator.Position = UDim2.new(0, 0, 1, 0)
					separator.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
					separator.BorderSizePixel = 0
					separator.ZIndex = 104
					separator.Parent = optionButton
				end

				local dot = Instance.new("Frame")
				dot.Name = "Dot"
				dot.Size = UDim2.new(0, 4, 0, 4)
				dot.Position = UDim2.new(0, 12, 0.5, 0)
				dot.AnchorPoint = Vector2.new(0, 0.5)
				dot.BackgroundColor3 = Color3.new(0, 0, 0)
				dot.BorderSizePixel = 0
				dot.ZIndex = 104
				dot.Parent = optionButton
				corner(dot, UDim.new(1, 0))

				local optionText = Instance.new("TextLabel")
				optionText.Size = UDim2.new(1, -30, 1, 0)
				optionText.Position = UDim2.new(0, 30, 0, 0)
				optionText.BackgroundTransparency = 1
				optionText.Text = optionName
				optionText.Font = Enum.Font.Gotham
				optionText.TextSize = 16
				optionText.TextColor3 = Color3.new(0, 0, 0)
				optionText.TextXAlignment = Enum.TextXAlignment.Left
				optionText.ZIndex = 104
				optionText.Parent = optionButton

				optionRows[optionName] = {button = optionButton, dot = dot}

				local function restColor()
					if multi and isSelected(optionName) then
						return Color3.fromRGB(210, 210, 210)
					end
					return Color3.fromRGB(245, 245, 245)
				end

				optionButton.MouseEnter:Connect(function()
					if not (multi and isSelected(optionName)) then
						optionButton.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
					end
				end)
				optionButton.MouseLeave:Connect(function()
					optionButton.BackgroundColor3 = restColor()
				end)

				optionButton.MouseButton1Click:Connect(function()
					Window.ClickSound:Play()
					if multi then
						local nextSel = table.clone(selectedParts)
						local idx = table.find(nextSel, optionName)
						if idx then
							table.remove(nextSel, idx)
						else
							table.insert(nextSel, optionName)
						end
						setState(nextSel)
					else
						setState(optionName)
					end
				end)
			end

			refresh(false)

			local hold = makeHold(Window, dropdownContainer, dropdownContainer, {
				name = text,
				spawn = function(pos)
					local item
					item = Library.CreateDropdown({
						label = text, options = options, multi = multi,
						default = multi and table.clone(selectedParts) or selectedOption, -- current choice, not the old default
						position = pos,
						callback = function(v) setState(v) end -- copy -> original (+ other copies)
					})
					table.insert(listeners, function(v) -- original -> copy
						if not item.frame:IsDescendantOf(game) then return false end
						item.setSelected(v, true)
						return true
					end)
					return item
				end
			})
			hold.bind(dropdownContainer)
			hold.bind(selectionBox)

			-- only the box itself opens/closes the list (not the title or the background)
			selectionBox.MouseButton1Click:Connect(function()
				if hold.wasFired() then return end
				Window.ClickSound:Play()
				if isOpen then closeDropdown() else openDropdown() end
			end)

			register(dropdownContainer, text)
			return dropdownContainer, {
				set = setState,
				get = function()
					return multi and table.clone(selectedParts) or selectedOption
				end
			}
		end

		function Tab:AddDropdown(text, options, callback)
			return buildDropdown(text, options, nil, callback, true)
		end

		function Tab:AddDropdownSingle(text, options, default, callback)
			return buildDropdown(text, options, default, callback, false)
		end

		-- Returns a table { Container, TextBox, SetText } (kept compatible)
		function Tab:AddInput(text, placeholder, callback)
			Tab.ElementCount = Tab.ElementCount + 1

			local inputContainer = Instance.new("Frame")
			inputContainer.Size = UDim2.new(1, 0, 0, 80)
			inputContainer.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
			inputContainer.BorderSizePixel = 0
			inputContainer.ZIndex = 99
			inputContainer.LayoutOrder = Tab.ElementCount
			inputContainer.Parent = scrollFrame
			inputContainer.AutomaticSize = Enum.AutomaticSize.Y -- grows with long text
			local inputPad = Instance.new("UIPadding")
			inputPad.PaddingBottom = UDim.new(0, 5)
			inputPad.Parent = inputContainer
			corner(inputContainer, UDim.new(0, 12))
			stroke(inputContainer, 2)

			local inputLabel = Instance.new("TextLabel")
			inputLabel.Size = UDim2.new(0, 150, 0, 25)
			inputLabel.Position = UDim2.new(0, 10, 0, 5)
			inputLabel.BackgroundTransparency = 1
			inputLabel.Text = text
			inputLabel.Font = Enum.Font.GothamBold
			inputLabel.TextSize = 18
			inputLabel.TextColor3 = Color3.new(0, 0, 0)
			inputLabel.TextXAlignment = Enum.TextXAlignment.Left
			inputLabel.ZIndex = 99
			inputLabel.Parent = inputContainer

			local textBoxFrame = Instance.new("Frame")
			textBoxFrame.Size = UDim2.new(1, -20, 0, 40)
			textBoxFrame.AutomaticSize = Enum.AutomaticSize.Y
			textBoxFrame.Position = UDim2.new(0, 10, 0, 35)
			textBoxFrame.BackgroundColor3 = Color3.new(1, 1, 1)
			textBoxFrame.BorderSizePixel = 0
			textBoxFrame.ZIndex = 99
			textBoxFrame.Parent = inputContainer
			corner(textBoxFrame, UDim.new(0, 8))
			local textBoxStroke = stroke(textBoxFrame, 1.5)

			local textBox = Instance.new("TextBox")
			local boxPad = Instance.new("UIPadding")
			boxPad.PaddingTop = UDim.new(0, 4)
			boxPad.PaddingBottom = UDim.new(0, 4)
			boxPad.PaddingLeft = UDim.new(0, 8)
			boxPad.PaddingRight = UDim.new(0, 8)
			boxPad.Parent = textBoxFrame
			textBox.Size = UDim2.new(1, 0, 0, 32)
			textBox.AutomaticSize = Enum.AutomaticSize.Y
			textBox.MultiLine = true
			textBox.BackgroundTransparency = 1
			textBox.Text = ""
			textBox.PlaceholderText = placeholder or "Enter text..."
			textBox.TextColor3 = Color3.new(0, 0, 0)
			textBox.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
			textBox.TextSize = 16
			textBox.Font = Enum.Font.Gotham
			textBox.TextXAlignment = Enum.TextXAlignment.Left
			textBox.ClearTextOnFocus = false
			textBox.TextWrapped = true
			textBox.ZIndex = 100
			textBox.Parent = textBoxFrame

			local listeners = {}

			-- one place that syncs the text everywhere (original + all copies)
			local function mirror(t)
				if textBox.Text ~= t then textBox.Text = t end
				for i = #listeners, 1, -1 do
					if not listeners[i](t) then table.remove(listeners, i) end
				end
			end

			textBox:GetPropertyChangedSignal("Text"):Connect(function()
				if string.find(textBox.Text, "[\r\n]") then
					textBox.Text = (string.gsub(textBox.Text, "[\r\n]", ""))
					textBox:ReleaseFocus(true)
				end
			end)

			textBox.Focused:Connect(function()
				TweenService:Create(textBoxStroke, TweenInfo.new(0.2), {
					Color = Color3.fromRGB(100, 150, 255),
					Thickness = 2
				}):Play()
			end)

			textBox.FocusLost:Connect(function(enterPressed)
				TweenService:Create(textBoxStroke, TweenInfo.new(0.2), {
					Color = Color3.new(0, 0, 0),
					Thickness = 1.5
				}):Play()
				mirror(textBox.Text) -- copies show what was typed here
				if enterPressed then
					safe(callback, textBox.Text)
				end
			end)

			local hold = makeHold(Window, inputContainer, inputContainer, {
				name = text,
				spawn = function(pos)
					local item
					item = Library.CreateInput({
						label = text, placeholder = placeholder, callback = callback, position = pos,
						default = textBox.Text,
						onChange = function(t) mirror(t) end -- copy -> original (+ other copies)
					})
					table.insert(listeners, function(t) -- original -> copy
						if not item.frame:IsDescendantOf(game) then return false end
						item.setText(t)
						return true
					end)
					return item
				end
			})
			hold.bind(inputContainer)
			hold.bind(textBoxFrame)
			hold.bind(textBox)

			register(inputContainer, text)
			return {
				Container = inputContainer,
				TextBox = textBox,
				SetText = mirror
			}
		end

		return Tab
	end

