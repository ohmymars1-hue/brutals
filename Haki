	local function swapSidebar(showSettings)
		TweenService:Create(sidebarScrollFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(-1, 0, 0, 60)
		}):Play()
		task.delay(0.2, function()
			if not sidebarScrollFrame.Parent then return end
			for _, b in pairs(Window.TabButtons) do b.Visible = not showSettings end
			for _, b in pairs(settingsTabButtons) do b.Visible = showSettings end
			sidebarScrollFrame.Position = UDim2.new(1, 0, 0, 60)
			TweenService:Create(sidebarScrollFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(0, 0, 0, 60)
			}):Play()
		end)
	end

	settingsButton.MouseButton1Click:Connect(function()
		clickSound:Play()
