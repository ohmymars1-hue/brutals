	-- SEARCH BAR (used by the SEARCH tab AND the UNIVERSAL tab)
	-- It looks through the names of the elements of the tabs that getTabs()
	-- returns and shows the real elements in the tab it lives in: they are moved
	-- there while you search and put back when you clear the bar or leave the tab,
	-- so a toggle / slider / dropdown / input / button here is the original one,
	-- not a copy.
	--
	--   SEARCH bar    -> every tab EXCEPT the UNIVERSAL tab
	--   UNIVERSAL bar -> ONLY the UNIVERSAL tab (nothing from any other tab)
	--
	-- Results are grouped as a tree, every tab with a match gets its name on top
	-- and a line on the left that connects its components:
	--
	--   —( Main )
	--   |__[Flight]
	--   |__[Freeze]
	--
	--   tab      = the tab the bar is placed in
	--   base     = results use LayoutOrder base+1, base+2, ... (so they sit below
	--              anything that is already in the tab)
	--   isActive = returns true while this bar is really on screen
	--   getTabs  = returns the list of tabs this bar is allowed to search
	----------------------------------------------------------------------
	local searchOrigins = {}   -- row -> { parent, order, position } (where it belongs)
	local activeRestore = nil  -- restore function of the bar that currently shows results

	local TREE_INDENT = 24     -- space on the left of a component for the tree line
	local TREE_X = -16         -- x of the vertical line (relative to the indented content)
	local TREE_BRANCH_Y = 24   -- height of the "__" branch inside a row

	local function attachSearch(tab, base, isActive, getTabs)
		local sf = tab.Frame

		local bar = Instance.new("Frame")
